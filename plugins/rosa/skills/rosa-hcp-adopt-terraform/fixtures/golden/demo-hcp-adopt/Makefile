# Generated by MOBB ROSA skills — review before destroy.
# Apply order: network → cluster. Destroy order: cluster → network.

AWS_REGION ?= ap-southeast-2
export AWS_DEFAULT_REGION := $(AWS_REGION)
# Export RHCS_TOKEN before cluster-plan / cluster-apply (see README: rosa token).

CLUSTER_DIR := .
NETWORK_DIR := network
NETWORK_STACK := 0

.PHONY: help init fmt validate \
	cluster-init cluster-fmt cluster-validate cluster-plan cluster-apply cluster-destroy \
	network-init network-fmt network-validate network-plan network-apply network-destroy \
	plan apply destroy

help:
	@echo "Split ROSA stack (cluster root + optional network/)"
	@echo "  make init      terraform init (cluster + network when present)"
	@echo "  make plan      network plan then cluster plan (when network/)"
	@echo "  make apply     network apply then cluster apply"
	@echo "  make destroy   cluster destroy then network destroy"
	@echo "  make cluster-plan / network-plan   single-root targets"

init: cluster-init
ifeq ($(NETWORK_STACK),1)
init: network-init
endif

fmt: cluster-fmt
ifeq ($(NETWORK_STACK),1)
fmt: network-fmt
endif

validate: cluster-validate
ifeq ($(NETWORK_STACK),1)
validate: network-validate
endif

cluster-init:
	cd $(CLUSTER_DIR) && terraform init

cluster-fmt:
	cd $(CLUSTER_DIR) && terraform fmt -recursive

cluster-validate:
	cd $(CLUSTER_DIR) && terraform validate

cluster-plan:
	cd $(CLUSTER_DIR) && terraform plan

cluster-apply:
	cd $(CLUSTER_DIR) && terraform apply

cluster-destroy:
	cd $(CLUSTER_DIR) && terraform destroy

ifeq ($(NETWORK_STACK),1)
network-init:
	cd $(NETWORK_DIR) && terraform init

network-fmt:
	cd $(NETWORK_DIR) && terraform fmt -recursive

network-validate:
	cd $(NETWORK_DIR) && terraform validate

network-plan:
	cd $(NETWORK_DIR) && terraform plan

network-apply:
	cd $(NETWORK_DIR) && terraform apply

network-destroy:
	cd $(NETWORK_DIR) && terraform destroy

plan: network-plan cluster-plan

apply: network-apply cluster-apply

destroy: cluster-destroy network-destroy
else
plan: cluster-plan

apply: cluster-apply

destroy: cluster-destroy
endif
